# Mendeles — Backend
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars

POSTGRES_DB=mendeles
POSTGRES_USER=mendeles
POSTGRES_PASSWORD=mendeles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/mendeles

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
ALLOWED_HOSTS=localhost,127.0.0.1

DEFAULT_FROM_EMAIL=noreply@mendeles.co.il
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

JWT_COOKIE_SECURE=false
APP_VERSION=1.0.0

# Bootstrap superuser (ensure_superuser command)
BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
BOOTSTRAP_ADMIN_PASSWORD=admin
