# Mendeles — Backend
DJANGO_SETTINGS_MODULE=config.settings.development
DEBUG=true
DJANGO_SECRET_KEY=change-me-in-production
JWT_SECRET_KEY=change-me-jwt-secret-min-32-chars

POSTGRES_DB=mendeles
POSTGRES_USER=mendeles
POSTGRES_PASSWORD=mendeles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# DATABASE_URL=postgresql://user:pass@host:5432/mendeles

CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Production (Railway backend):
# FRONTEND_URL=https://mendeles.com
# SITE_URL=https://mendeles.com
# CORS_ALLOWED_ORIGINS=https://mendeles.com,https://www.mendeles.com
ALLOWED_HOSTS=localhost,127.0.0.1

DEFAULT_FROM_EMAIL=noreply@mandeles.co.il
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Email verification (Resend) — required in production
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=Mandeles <noreply@mandeles.co.il>
# When RESEND_API_KEY is set, EMAIL_BACKEND auto-selects Resend (no need to set EMAIL_BACKEND)

# WhatsApp — Evolution API (Phase 1)
WHATSAPP_PROVIDER=evolution
# EVOLUTION_API_URL=https://your-evolution-api.example.com
# EVOLUTION_API_KEY=your-api-key
# EVOLUTION_INSTANCE=mendeles

# Legacy Twilio bot (optional — separate from Evolution)
# WHATSAPP_AGENT_ENABLED=true
# TWILIO_ACCOUNT_SID=AC...
# TWILIO_AUTH_TOKEN=...
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# GEMINI_API_KEY=...  # campaign copy + attractive Generate images (gemini-2.5-flash-image)
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_IMAGE_TIMEOUT_SECONDS=90

# Buffer (AI social campaigns) — server-side only, never expose to frontend
# Generate at https://publish.buffer.com/settings/api
# BUFFER_ACCESS_TOKEN=
# Public backend origin so Buffer can fetch generated Instagram/TikTok media files
# BACKEND_PUBLIC_URL=https://your-backend.example.com

# Facebook Page (direct Meta Graph — independent of Buffer's 3-channel limit)
# Create a Facebook App → Page access token with pages_manage_posts, pages_read_engagement
# FACEBOOK_PAGE_ID=
# FACEBOOK_PAGE_ACCESS_TOKEN=
# FACEBOOK_PAGE_NAME=Mendeles
# Optional — validate token scopes in /api/v1/social/status/
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=
# Channels (Instagram, TikTok, LinkedIn, Facebook, Threads, YouTube, X, Bluesky, …)
# are discovered automatically from the GraphQL API — no BUFFER_PROFILE_* vars.

# TikTok AI video providers — default: Runway → Veo 3.1 → local SVG fallback
# VIDEO_PROVIDER_FAILOVER=runway,veo,local
# VIDEO_PROVIDER_POLL_SECONDS=300
# VIDEO_PROVIDERS_MOCK=true
# RUNWAY_API_KEY=
# RUNWAY_MODEL=gen4_turbo
# VIDEO_RUNWAY_CREDITS=50
# VEO_API_KEY=   # or reuse GEMINI_API_KEY
# VEO_MODEL=veo-3.1-generate-preview
# VIDEO_VEO_CREDITS=50
# Optional extras (include in VIDEO_PROVIDER_FAILOVER if needed):
# FAL_KEY=
# LTX_API_KEY=
# KLING_API_KEY=
# KLING_API_BASE=https://api.example-kling.com

JWT_COOKIE_SECURE=false
APP_VERSION=1.0.0

# Google OAuth (Search Console + Analytics 4) — required before Connect
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Preferred redirect (auto if FRONTEND_URL is set) — add this EXACT URI in Google Cloud Console:
# https://mendeles.com/oauth/google/integrations/callback
# GOOGLE_OAUTH_REDIRECT_URI=https://mendeles.com/oauth/google/integrations/callback
# INTEGRATIONS_ENCRYPTION_KEY=generate-a-random-32-char-or-longer-secret

# Google Sign-In (user login) — optional dedicated credentials; otherwise reuses GOOGLE_OAUTH_* client
# Authorized redirect URI in Google Cloud Console (frontend callback — preferred):
# https://mendeles.com/oauth/google/callback
# GOOGLE_LOGIN_REDIRECT_URI=https://mendeles.com/oauth/google/callback
# GOOGLE_LOGIN_CLIENT_ID=
# GOOGLE_LOGIN_CLIENT_SECRET=

# Bootstrap superuser (ensure_superuser command)
BOOTSTRAP_ADMIN_EMAIL=admin@admin.com
BOOTSTRAP_ADMIN_PASSWORD=admin
