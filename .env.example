# Mendeles monorepo — copy to backend/.env and frontend/.env.local

# Backend (backend/.env)
DJANGO_SETTINGS_MODULE=config.settings.development
DATABASE_URL=postgresql://mendeles:mendeles@localhost:5432/mendeles
DJANGO_SECRET_KEY=change-me-min-50-chars-for-production
JWT_SECRET_KEY=change-me-jwt-secret-minimum-32-characters
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Frontend (frontend/.env.local)
API_URL=http://localhost:8000
