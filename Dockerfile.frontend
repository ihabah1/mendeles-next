# Frontend — Railway: set Root Directory to EMPTY (repo root).
# Dockerfile path: Dockerfile.frontend
FROM node:20-alpine AS deps
WORKDIR /app
RUN apk add --no-cache libc6-compat
# Pin npm 10 — avoids npm 11 ci regressions on some Alpine images
RUN npm install -g npm@10.9.2

COPY frontend/package.json ./
COPY frontend/package-lock.json ./

RUN test -s package-lock.json \
  && node -e "const p=require('./package.json'); if(!p.dependencies?.next){console.error('FATAL: wrong package.json copied — Railway Root Directory must be empty (repo root)'); process.exit(1)}" \
  && npm ci --ignore-scripts --no-audit --no-fund

FROM node:20-alpine AS builder
WORKDIR /app
RUN apk add --no-cache libc6-compat
COPY --from=deps /app/node_modules ./node_modules
COPY frontend/ .
ARG API_URL=http://localhost:8000
ENV API_URL=$API_URL
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN npm run build

FROM node:20-alpine AS runner
WORKDIR /app
RUN apk add --no-cache libc6-compat
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
# Railway injects PORT at runtime; 3000 is fallback only
ENV PORT=3000

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
